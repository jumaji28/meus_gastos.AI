{
  "name": "Meus Gastos.AI",
  "short_name": "Meus Gastos",
  "description": "Painel financeiro pessoal montado a partir dos extratos e faturas do seu banco.",
  "id": "/",
  "start_url": "/?origem=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "lang": "pt-BR",
  "background_color": "#F1F4F1",
  "theme_color": "#103A31",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "application/pdf", ".pdf",
            "text/csv", "text/comma-separated-values", "text/plain", ".csv", ".txt",
            "application/x-ofx", "application/ofx", ".ofx", ".qfx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.ms-excel", ".xlsx", ".xls",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
